{
  "name": "argusdesk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build:mock": "tsc && vite build --mode mock --outDir dist-mock",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
