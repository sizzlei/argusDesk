<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="argusdesk"
        Arguments=""
        InstallLocation="C:\Program Files\sizzlei\ArgusDesk">
    </Installer>
    <PackageInformation
        PackageName="ArgusDesk"
        PackageDisplayName="ArgusDesk"
        PublisherName="CN=sizzlei"
        PublisherDisplayName="sizzlei"
        Version="0.1.0.0"
        PackageDescription="Jira service desk as a fulfilment centre">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.sizzlei.argusdesk"
                Description="Jira service desk as a fulfilment centre"
                DisplayName="ArgusDesk"
                ExecutableName="argusdesk"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ArgusDesk</DisplayName>
            <PublisherDisplayName>sizzlei</PublisherDisplayName>
            <Description>Jira service desk as a fulfilment centre</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="argusdesk.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
